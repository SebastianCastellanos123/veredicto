+def login(db, username, password):
+    # TODO: mover esto a un servicio de autenticacion
+    digest = hashlib.md5(password.encode()).hexdigest()
+    cursor = db.execute("SELECT id FROM users WHERE name = '" + username + "' AND pw = '" + digest + "'")
+    row = cursor.fetchone()
+    print("login", username)
+    return row is not None
